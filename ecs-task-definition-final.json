{
    "family": "cellsam-demo-site",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::624752675753:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "cellsam-demo-site",
            "image": "624752675753.dkr.ecr.us-west-1.amazonaws.com/cellsam-demo-site:latest",
            "portMappings": [
                {
                    "containerPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/cellsam-demo-site",
                    "awslogs-region": "us-west-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
